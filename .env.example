# ---------------------------------------------------------------------------
# Candlebench - example environment file. Copy to `.env` and adjust.
# NEVER commit `.env` or any real credentials to version control.
#
# SECURITY MODEL (v1):
#   All configuration is read on the SERVER only. Nothing here is ever sent
#   to the browser, written to logs, or bundled into client code.
#
# v1 intentionally implements NO order placement of any kind (paper only),
# so no exchange API credentials are read by the current code. The vars
# below are placeholders reserved for a future OKX *demo-trading* adapter
# (see README "OKX demo trading" section). They are documented but NOT used.
# ---------------------------------------------------------------------------

# Server
PORT=3000
HOST=0.0.0.0

# Market data source: "auto" (try OKX public API, fall back to sample data),
# "okx" (OKX public market data only), or "sample" (deterministic simulated
# prices, always clearly labelled in the UI).
DATA_SOURCE=auto

# OKX public REST base URL (public market data only in v1 - read-only).
OKX_BASE_URL=https://www.okx.com
OKX_TIMEOUT_MS=4000

# --- RESERVED FOR FUTURE OKX DEMO-TRADING ADAPTER (NOT USED IN v1) ---------
# If ever implemented, these would be used ONLY server-side and ONLY against
# OKX demo trading (header x-simulated-trading: 1). Withdrawal permissions
# must never be granted to such a key. Leave unset.
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_API_PASSPHRASE=

# Optional: where the paper-engine state snapshot is stored (gitignored).
DATA_DIR=./data
