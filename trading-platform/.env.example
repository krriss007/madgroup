# Copy to .env and fill in. .env is git-ignored.

# Live market prices from Finnhub (https://finnhub.io). Optional.
# Streams forex, metals and crypto trades over WebSocket.
FINNHUB_API_KEY=

# Live crypto prices from Binance public streams. No key needed. Set to 0 to disable.
BINANCE_ENABLED=1
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# Force simulated prices for everything: "sim". Default: "auto" (live feeds where available).
MARKET_MODE=auto

# AI agent LLM mode (optional). Any OpenAI-compatible chat-completions endpoint.
# Rules-based strategies work without these.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Server
PORT=3000
HOST=0.0.0.0
