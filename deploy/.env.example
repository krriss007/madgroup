# TradePilot — deploy/docker-compose.yml configuration.
# Copy to deploy/.env and fill in every value. Never commit the filled-in file.
#
#   cp deploy/.env.example deploy/.env

# The hostname that will serve the app, e.g. tradepilot.example.com.
# Must resolve to this machine before Caddy can obtain a certificate.
DOMAIN=

# 32+ byte secrets. Generate each with:  openssl rand -hex 32
# SESSION_SECRET signs the session cookies; BRIDGE_SECRET signs every command
# sent to an MT5 Expert Advisor. Losing BRIDGE_SECRET invalidates device tokens.
SESSION_SECRET=
BRIDGE_SECRET=

# PostgreSQL password for the tradepilot user.  openssl rand -hex 24
POSTGRES_PASSWORD=
